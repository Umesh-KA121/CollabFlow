{
  "name": "collabflow",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Multi-tenant real-time team collaboration SaaS",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace=@collabflow/web",
    "dev:api": "npm run dev --workspace=@collabflow/api",
    "build": "npm run build --workspaces",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm test --workspaces"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.10",
    "typescript-eslint": "^8.72.1"
  }
}
