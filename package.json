{
  "name": "collabflow",
  "version": "1.0.0",
  "private": true,
  "description": "Multi-tenant real-time team collaboration SaaS",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace=@collabflow/web",
    "dev:api": "npm run dev --workspace=@collabflow/api",
    "build": "npm run build --workspaces",
    "test": "npm test --workspaces"
  }
}